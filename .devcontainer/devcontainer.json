{
  "name": "ZenithPS5",
  "image": "mcr.microsoft.com/devcontainers/cpp:1-ubuntu-24.04",
  "runArgs": ["--cap-add=SYS_PTRACE", "--security-opt", "seccomp=unconfined"],
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y ninja-build clang clang-format clang-tidy gdb libvulkan-dev vulkan-validationlayers",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "llvm-vs-code-extensions.vscode-clangd",
        "editorconfig.editorconfig"
      ],
      "settings": {
        "C_Cpp.intelliSenseEngine": "disabled",
        "cmake.useCMakePresets": "always"
      }
    }
  }
}
